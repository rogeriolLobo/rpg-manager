{
  "name": "rpg-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-build-info.mjs",
    "dev": "vite dev --host 127.0.0.1 --port 5173",
    "prebuild": "node scripts/generate-build-info.mjs",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "predeploy": "node scripts/generate-build-info.mjs",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "node scripts/generate-build-info.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.integration.json --noEmit",
    "pretest": "node scripts/generate-build-info.mjs",
    "test": "vitest run --coverage",
    "pretest:integration": "node scripts/generate-build-info.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 migrations apply DB --local",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "hono": "4.13.1",
    "lucide-react": "1.31.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.52.0",
    "@cloudflare/vitest-pool-workers": "0.21.2",
    "@cloudflare/workers-types": "5.20260812.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.122.0"
  }
}
